parametersSchema:
    fluentValidationNoUnboundedArrayEach: structure([
        namespaces: listOf(string())
        excludeNamespaces: listOf(string())
        boundingMethods: listOf(string())
        boundingRuleStringPrefixes: listOf(string())
    ])

parameters:
    fluentValidationNoUnboundedArrayEach:
        namespaces:
            - App
        excludeNamespaces: []
        boundingMethods:
            - max
            - between
            - exactly
        boundingRuleStringPrefixes:
            - max
            - size
            - between

services:
    -
        class: SanderMuller\LaravelFluentValidationPhpstan\Rules\Support\FactoryInspector
    -
        class: SanderMuller\LaravelFluentValidationPhpstan\Rules\Support\KeysInspector
    -
        class: SanderMuller\LaravelFluentValidationPhpstan\Rules\Support\BoundingInspector
        arguments:
            boundingMethods: %fluentValidationNoUnboundedArrayEach.boundingMethods%
            boundingRuleStringPrefixes: %fluentValidationNoUnboundedArrayEach.boundingRuleStringPrefixes%
    -
        class: SanderMuller\LaravelFluentValidationPhpstan\Parser\FluentValidationChainVisitor
        tags:
            - phpstan.parser.richParserNodeVisitor
    -
        class: SanderMuller\LaravelFluentValidationPhpstan\Types\SchemaRulesResolver
    -
        class: SanderMuller\LaravelFluentValidationPhpstan\Types\RulesReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
    -
        class: SanderMuller\LaravelFluentValidationPhpstan\Types\RulesStaticReturnTypeExtension
        tags:
            - phpstan.broker.dynamicStaticMethodReturnTypeExtension
    -
        class: SanderMuller\LaravelFluentValidationPhpstan\Types\CallArguments
    -
        class: SanderMuller\LaravelFluentValidationPhpstan\Types\RuleArgumentClassifier
    -
        class: SanderMuller\LaravelFluentValidationPhpstan\Types\RuleChainModifiers
    -
        class: SanderMuller\LaravelFluentValidationPhpstan\Types\RuleChainReader
    -
        class: SanderMuller\LaravelFluentValidationPhpstan\Types\ValidatedShapeResolver
    -
        class: SanderMuller\LaravelFluentValidationPhpstan\Types\RuleSetFromReturnTypeExtension
        tags:
            - phpstan.broker.dynamicStaticMethodReturnTypeExtension
    -
        class: SanderMuller\LaravelFluentValidationPhpstan\Rules\NoUnboundedArrayEachRule
        arguments:
            namespaces: %fluentValidationNoUnboundedArrayEach.namespaces%
            excludeNamespaces: %fluentValidationNoUnboundedArrayEach.excludeNamespaces%
        tags:
            - phpstan.rules.rule
